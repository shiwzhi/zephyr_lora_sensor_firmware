
/delete-node/ &code_partition;
#include <raspberrypi/partitions_2M_sysbuild.dtsi>

&flash0 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = < 0x1 >;
		#size-cells = < 0x1 >;

		second_stage_bootloader: partition@0 {
			label = "second_stage_bootloader";
			reg = < 0x0 0x100 >;
			read-only;
		};

		boot_partition: partition@100 {
			label = "mcuboot";
			reg = < 0x100 0xfe00 >;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = < 0x10000 0x40000 >;
		};

		slot1_partition: partition@E0000 {
			label = "image-1";
			reg = < 0xe0000 0x40000 >;
		};

		storage_partition: partition@1B0000 {
			label = "storage";
			reg = < 0x1b0000 0x50000 >;
		};
	};
};

/ {
    chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &st7789v;
		zephyr,code-partition = &slot0_partition;

    };

	aliases {
		sht3x-sensor = &sht3x;
		cm1106-uart = &uart0;
		pms-uart = &uart1;
		lora0 = &sx126x;
	};

	mipi_dbi_st7796s {
		status = "okay";
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;	/* D9 */
		reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@1 {
			status = "okay";
			compatible = "sitronix,st7789v";
			mipi-max-frequency = <DT_FREQ_M(30)>;
			reg = <1>;
			width = <320>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x19>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x60>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23];
			nvgam-param = [D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23];
			ram-param = [00 F0];
			rgb-param = [CD 08 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			inversion-off;
		};
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&uart0 {
	current-speed = <9600>;
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&uart1 {
	current-speed = <9600>;
	status = "okay";
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&spi0 {
	clock-frequency = <DT_FREQ_M(30)>;
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>,
			   <&gpio0 21 GPIO_ACTIVE_LOW>;

	sx126x: sx126x@0 {
		status = "okay";
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(15)>;
		reset-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	sht3x: sht3xd@44 {
		compatible = "sensirion,sht3xd";
		reg = <0x44>;
	};

};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_P12>;
		};
		group2 {
			pinmux = <UART0_RX_P13>;
			input-enable;
		};
	};

	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_P8>;
		};
		group2 {
			pinmux = <UART1_RX_P9>;
			input-enable;
		};
	};

	spi0_default: spi0_default {
		group1 {
			pinmux = <SPI0_CSN_P21>, <SPI0_SCK_P18>, <SPI0_TX_P19>;
		};
		group2 {
			pinmux = <SPI0_RX_P20>;
			input-enable;
		};
	};

	i2c1_default: i2c1_default {
		group1 {
			pinmux = <I2C1_SDA_P14>, <I2C1_SCL_P15>;
			input-enable;
			input-schmitt-enable;
		};
	};

};