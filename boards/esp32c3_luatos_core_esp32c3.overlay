/ {
    chosen {
		zephyr,code-partition = &slot0_partition;
    };

    aliases {
        lora0 = &sx1262;
		systemled = &led0;
		sht3x = &sht3x;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_2 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "White LED";
		};

		led1: led_1 {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};
};

&wdt1 {
	status = "okay";                     /* in zephyr/dts/riscv/espressif/esp32c3/esp32c3_common.dtsi:303 */
};

&i2c0_default {
	group1 {
		pinmux = <I2C0_SDA_GPIO2>,
				<I2C0_SCL_GPIO0>;
		bias-pull-up;
		drive-open-drain;
		output-high;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	sht3x: sht3xd@44 {
		compatible = "sensirion,sht3xd";
		reg = <0x44>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&spim2_default {
    group1 {
        pinmux = <SPIM2_MISO_GPIO6>,
            <SPIM2_SCLK_GPIO10>;
    };
    group2 {
        pinmux = <SPIM2_MOSI_GPIO7>;
        output-low;
    };
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
    cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
    clock-frequency = <DT_FREQ_M(8)>;

	sx1262: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		label = "SX1262";
		reset-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(64)>;
		};

		sys_partition: partition@10000 {
			label = "sys";
			reg = <0x10000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x20000 DT_SIZE_K(256)>;
		};

		slot1_partition: partition@1e0000 {
			label = "image-1";
			reg = <0x1E0000 DT_SIZE_K(256)>;
		};

		slot0_lpcore_partition: partition@3a0000 {
			label = "image-0-lpcore";
			reg = <0x3A0000 DT_SIZE_K(32)>;
		};

		slot1_lpcore_partition: partition@3a8000 {
			label = "image-1-lpcore";
			reg = <0x3A8000 DT_SIZE_K(32)>;
		};

		storage_partition: partition@3b0000 {
			label = "storage";
			reg = <0x3B0000 DT_SIZE_K(192)>;
		};

		scratch_partition: partition@3e0000 {
			label = "image-scratch";
			reg = <0x3E0000 DT_SIZE_K(124)>;
		};

		coredump_partition: partition@3ff000 {
			label = "coredump";
			reg = <0x3FF000 DT_SIZE_K(4)>;
		};
	};
};