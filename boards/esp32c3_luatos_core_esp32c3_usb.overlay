/ {
    choose {
    };

    aliases {
        pms-uart = &uart0;
        lora0 = &lora;
		systemled = &led0;
		scd4x = &scd40;
		bme280 = &bme280;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_2 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "White LED";
		};

		led1: led_1 {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};
};

&i2c0_default {
	group1 {
		pinmux = <I2C0_SDA_GPIO1>,
				<I2C0_SCL_GPIO0>;
		bias-pull-up;
		drive-open-drain;
		output-high;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	scd40: scd40@62 {
        status = "okay";
        reg = <0x62>;
		mode = <1>;
        compatible = "sensirion,scd41";
    };

	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO5>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO4>;
			bias-pull-up;
		};
};

&spim2_default {
    group1 {
        pinmux = <SPIM2_MISO_GPIO3>,
            <SPIM2_SCLK_GPIO7>;
    };
    group2 {
        pinmux = <SPIM2_MOSI_GPIO10>;
        output-low;
    };
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
    clock-frequency = <DT_FREQ_M(1)>;

    lora: lora@0 {
		compatible = "semtech,sx1276";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(2)>;
		reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
		dio-gpios = <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
        power-amplifier-output = "pa-boost";
	};
};