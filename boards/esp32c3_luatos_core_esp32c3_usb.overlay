/ {
    choose {
    };

    aliases {
        cm1106-uart = &uart0;
        lora-radio = &lora;
	};

};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO5>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO4>;
			bias-pull-up;
		};
};

&spim2_default {
    group1 {
        pinmux = <SPIM2_MISO_GPIO3>,
            <SPIM2_SCLK_GPIO7>;
    };
    group2 {
        pinmux = <SPIM2_MOSI_GPIO10>;
        output-low;
    };
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
    clock-frequency = <DT_FREQ_M(2)>;


    lora: lora@0 {
		compatible = "semtech,sx1276";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(2)>;
		reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
		dio-gpios = <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
        power-amplifier-output = "pa-boost";
	};
};