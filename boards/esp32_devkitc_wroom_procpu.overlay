/ {
	chosen {
		zephyr,display = &st7735;
    };

	aliases {
		cm1106-uart = &uart1;
        pms-uart = &uart2;
        lora-radio = &lora;
		lcd-display = &st7735;
	};

	mipi_dbi_st7735r_ada_160x128 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;	/* D9 */
		reset-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;	/* D8 */
		#address-cells = <1>;
		#size-cells = <0>;
		
		st7735: st7735r@0 {
			compatible = "sitronix,st7735r";
			mipi-max-frequency = <DT_FREQ_M(1)>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			reg = <0>;
			width = <128>;
			height = <160>;
			x-offset = <0>;
			y-offset = <0>;
			madctl = <0xc0>;
			colmod = <0x55>;
			vmctr1 = <0x0e>;
			pwctr1 = [a2 02 84];
			pwctr2 = [c5];
			pwctr3 = [0a 00];
			pwctr4 = [8a 2a];
			pwctr5 = [8a ee];
			frmctr1 = [01 2c 2d];
			frmctr2 = [01 2c 2d];
			frmctr3 = [01 2c 2d 01 2c 2d];
			gamctrp1 = [02 1c 07 12 37 32 29 2d 29 25 2b 39 00 01 03 10];
			gamctrn1 = [03 1d 07 06 2e 2c 29 2d 2e 2e 37 3f 00 00 02 10];
		};
	};
};

&uart1 {
    status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&uart2 {
    status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
};

&spi2 {
	clock-frequency = <DT_FREQ_M(8)>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
    cs-gpios = <&gpio0 4  GPIO_ACTIVE_LOW>,
			   <&gpio0 23 GPIO_ACTIVE_LOW>;

	lora: lora@1 {
		compatible = "semtech,sx1276";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		dio-gpios = <&gpio0 22 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
        power-amplifier-output = "pa-boost";
	};

};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO17>;
		};
		group2 {
			pinmux = <UART1_RX_GPIO16>;
			bias-pull-up;
		};
	};

	uart2_default: uart2_default {
		group1 {
			pinmux = <UART2_TX_GPIO14>;
		};
		group2 {
			pinmux = <UART2_RX_GPIO13>;
			bias-pull-up;
		};
	};

    spim2_default: spim2_default {
		group1 {
			pinmux = <SPIM2_MISO_GPIO27>,
				 <SPIM2_SCLK_GPIO26>;

		};
		group2 {
			pinmux = <SPIM2_MOSI_GPIO25>;
			output-low;
		};
	};
};