/ {
	model = "RAKWireless RAK3172 WisDuo LPWAN Module with a STM32WLE5CC SoC";
	compatible = "stm32,rak3172_stm32wl";

	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,lorawan-transceiver = &lora;
	};

	leds {
		compatible = "gpio-leds";

		blue_led: led_2 {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};

		green_led: led_1 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};

	aliases {
		led0 = &green_led;
		lora0 = &lora;
		watchdog0 = &iwdg;
	};
};

&subghzspi {
	status = "okay";

	lora: radio@0 {
		status = "okay";
		tx-enable-gpios = <&gpioa 7 GPIO_ACTIVE_LOW>; /* FE_CTRL1 */
		rx-enable-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;  /* FE_CTRL2 */
		power-amplifier-output = "rfo-hp";
		rfo-hp-max-power = <22>;
	};
};

&usart2 {
    current-speed = <115200>;
    status = "okay";
    pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
};